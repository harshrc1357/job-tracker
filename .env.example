# Postgres connection string from Neon (neon.tech) — free tier
DATABASE_URL=postgres://user:password@ep-example.neon.tech/job_tracker?sslmode=require

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# This one client is shared by two separate flows, so it needs FOUR authorized redirect
# URIs total (local dev + production, for each flow):
#   http://localhost:3000/api/auth/google/callback
#   https://<your-vercel-domain>/api/auth/google/callback
#   http://localhost:3000/api/auth/login/callback
#   https://<your-vercel-domain>/api/auth/login/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/login/callback

# Groq (console.groq.com) — free tier, used to classify ambiguous emails and pull out due dates
GROQ_API_KEY=

# Same bot/chat already used for ClaudeClaw notifications, or a new bot — either works
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Random string you make up. Required as a query param on /api/sync so the endpoint
# can't be triggered by anyone who finds the URL. e.g. openssl rand -hex 16
CRON_SECRET=

# Gates the dashboard behind "Sign in with Google" (see src/middleware.ts). Only this
# exact email is allowed in — anyone else's Google account is rejected.
OWNER_EMAIL=

# Signs the session cookie issued after Google sign-in. Random string you make up,
# e.g. openssl rand -hex 32. Changing this logs everyone out.
SESSION_SECRET=
