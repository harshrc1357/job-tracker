# Postgres connection string (Supabase, Neon, or any Postgres). A remote host is always
# connected over TLS (see src/db/ssl.ts); put sslmode=require in the URL to say so yourself.
DATABASE_URL=postgres://user:password@ep-example.neon.tech/job_tracker?sslmode=require

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# This one client is shared by two separate flows, so it needs FOUR authorized redirect
# URIs total (local dev + production, for each flow):
#   http://localhost:3000/api/auth/google/callback
#   https://<your-vercel-domain>/api/auth/google/callback
#   http://localhost:3000/api/auth/login/callback
#   https://<your-vercel-domain>/api/auth/login/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/login/callback

# OpenRouter (openrouter.ai/keys) — classifies every email that survives the free
# prefilter, and pulls due dates out of interview/assessment mail. One key covers both
# models: google/gemini-2.5-flash-lite primary, openai/gpt-5-nano fallback.
# Roughly $0.00017 per email; the per-day ceiling in src/lib/llm/models.ts caps it.
OPENROUTER_API_KEY=

# Same bot/chat already used for ClaudeClaw notifications, or a new bot — either works
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Random string you make up, e.g. openssl rand -hex 32. /api/sync can be called without
# it (runs are rate limited to one per few minutes, and a caller without it only ever gets
# {"ok":true} back). A caller WITH it gets the run's counts and error text, so send it in an
# "Authorization: Bearer <secret>" header, never in the URL, where it lands in request logs.
CRON_SECRET=

# Gates the dashboard behind "Sign in with Google" (see src/middleware.ts). Only this
# exact email is allowed in — anyone else's Google account is rejected.
OWNER_EMAIL=

# Signs the session cookie issued after Google sign-in. Random string you make up,
# e.g. openssl rand -hex 32 (use at least 32 characters; a short secret can be guessed
# offline from a stolen cookie). Changing this logs everyone out.
SESSION_SECRET=

# Encrypts the Gmail refresh token in the google_auth table (AES-256-GCM, see
# src/lib/tokenCrypto.ts). 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required: without it the app will not save or read the Gmail connection. Keep it out of
# the database and out of backups. Losing or changing it means reconnecting Gmail once at
# /api/auth/google (the old token cannot be decrypted any more).
TOKEN_ENCRYPTION_KEY=

# Per-model per-day LLM cap. Defaults to 1000 when unset.
# Raise locally for a one-off backfill; leave unset in production.
LLM_CALLS_PER_DAY=1000

# How many days back each sync searches Gmail. Defaults to 60 when unset (max 365).
# A value set here (or in Vercel) overrides the default: remove it unless you want it.
# SYNC_LOOKBACK_DAYS=60
