# Postgres connection string from Neon (neon.tech) — free tier
DATABASE_URL=postgres://user:password@ep-example.neon.tech/job_tracker?sslmode=require

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Add http://localhost:3000/api/auth/google/callback as an authorized redirect URI for local dev,
# and https://<your-vercel-domain>/api/auth/google/callback for production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Groq (console.groq.com) — free tier, used to classify ambiguous emails and pull out due dates
GROQ_API_KEY=

# Same bot/chat already used for ClaudeClaw notifications, or a new bot — either works
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Random string you make up. Required as a query param on /api/sync so the endpoint
# can't be triggered by anyone who finds the URL. e.g. openssl rand -hex 16
CRON_SECRET=

# Gates the dashboard and /api/auth/google behind HTTP Basic Auth so the site isn't
# public. Pick any username/password — this is just for you, not a real user system.
DASHBOARD_USER=elon
DASHBOARD_PASSWORD=
